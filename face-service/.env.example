# ============================================================
#  Grebeg Suro Face Service — Environment
#  Salin ke .env (dibaca systemd via EnvironmentFile) lalu isi.
# ============================================================

# Koneksi Postgres — boleh memakai URL Prisma apa adanya; param non-libpq
# (schema, pgbouncer, connection_limit, …) otomatis disaring oleh service.
DATABASE_URL="postgresql://grebeg_user:PASSWORD@localhost:5432/grebeg?schema=public"

# ---- Threshold keputusan (tuning dari data lapangan, jangan hardcode) ----
# similarity >= AUTO            -> FACE_AUTO      (absen sukses + badge terverifikasi)
# REVIEW <= similarity < AUTO   -> FACE_LOW_CONF  (absen sukses, review admin)
# similarity < REVIEW           -> MANUAL_FALLBACK (absen sukses, review admin)
FACE_THRESHOLD_AUTO="0.50"
FACE_THRESHOLD_REVIEW="0.35"
# Top-1 global milik volunteer LAIN dengan similarity >= MISMATCH -> flag POSSIBLE_MISMATCH
FACE_THRESHOLD_MISMATCH="0.50"

# ---- Galeri & deteksi ----
FACE_GALLERY_TTL_SECONDS="60"   # cache galeri; Next.js juga memanggil POST /reload setelah menulis
FACE_DET_SIZE="640"             # ukuran input detektor (640 = preset buffalo_l)
FACE_DOMINANT_FACE_RATIO="0.5"  # wajah ke-2 >= 50% luas wajah terbesar -> MULTIPLE_FACES

# Lokasi cache model (opsional; default ~/.insightface)
# FACE_MODEL_ROOT="/var/www/grebeg-suro/face-service/models"

# ---- Bind (hanya dipakai `python app.py`; systemd unit set host/port via CLI) ----
FACE_SERVICE_HOST="127.0.0.1"
FACE_SERVICE_PORT="8001"
