  "private": true,
  "description": "Volunteer Attendance Management System for Grebeg Suro & Festival Nasional Reog Ponorogo",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/migrate-deploy.mjs && npm run build",
