# ============================================================
#  Grebeg Suro — Volunteer Attendance System
#  Environment Variables
# ============================================================

# ---- Database (PostgreSQL) ----
# LOKAL / VPS: satu URL saja sudah cukup (DIRECT_URL boleh = DATABASE_URL).
DATABASE_URL="postgresql://grebeg:grebeg_secret@localhost:5432/grebeg_suro?schema=public"
DIRECT_URL="postgresql://grebeg:grebeg_secret@localhost:5432/grebeg_suro?schema=public"
#
# NETLIFY + SUPABASE (serverless) — pakai 2 URL berbeda:
#  DATABASE_URL = koneksi POOLED (pooler :6543, untuk runtime serverless)
#    contoh: postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#  DIRECT_URL   = koneksi LANGSUNG (:5432, untuk prisma migrate)
#    contoh: postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Ambil kedua string dari Supabase: Project Settings -> Database -> Connection string.

# ---- Auth ----
# Generate with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-secret-string"
SESSION_COOKIE_NAME="grebeg_session"

# ---- App ----
NEXT_PUBLIC_APP_URL="https://157-10-253-86.sslip.io"
NEXT_PUBLIC_APP_NAME="Volunteer Grebeg Suro"

# ---- Supabase (Storage + Realtime) ----
# Optional: if unset, selfies fall back to base64 stored in the database.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attendance-selfies"

# ---- Telegram admin notifications (optional) ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---- Face Verification (optional) ----
# DUA MODE:
#  A) Tanpa server (default, gratis — cocok Netlify): deteksi wajah berjalan
#     di BROWSER volunteer (face-api.js, model dari /public/models); server
#     hanya membandingkan descriptor 128-dim terhadap galeri di DB.
#     Aktif otomatis selama FACE_SERVICE_URL kosong. Threshold jarak euclidean
#     (standar face-api: < 0.6 = orang sama; AUTO memakai 0.5 yang lebih ketat):
FACE_BROWSER_AUTO_DISTANCE="0.5"
FACE_BROWSER_REVIEW_DISTANCE="0.6"
FACE_BROWSER_MISMATCH_DISTANCE="0.5"
#  B) Face service InsightFace di VPS (lebih akurat): isi URL localhost service
#     (HARUS localhost; service memegang data biometrik, jangan diekspos publik).
#     Jika diisi, mode A otomatis tidak dipakai.
#     Threshold mode B (0.50/0.35) diatur di face-service/.env, bukan di sini.
FACE_SERVICE_URL=""
# Timeout panggilan verify (ms) — lewat ini langsung MANUAL_FALLBACK.
FACE_SERVICE_TIMEOUT_MS="5000"
# Self-learning: embedding check-in FACE_AUTO disimpan jika det_score >= nilai ini.
FACE_ENRICH_MIN_DET_SCORE="0.6"
# Rolling window galeri: maksimal embedding per volunteer (CHECKIN tertua dihapus, SEED aman).
FACE_GALLERY_MAX_EMBEDDINGS="30"

# ---- Default event geofence (used by seed) ----
EVENT_NAME="Grebeg Suro & Festival Nasional Reog Ponorogo"
EVENT_LAT="-7.8650"
EVENT_LONG="111.4690"
EVENT_RADIUS_METER="150"
